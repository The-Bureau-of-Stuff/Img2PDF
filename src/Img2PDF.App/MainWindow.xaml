<Window
    x:Class="Img2PDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Img2PDF.App.ViewModels"
    xmlns:converters="using:Img2PDF.App.Converters">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        </Grid.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="12,8">
                <TextBlock Text="Zoom" VerticalAlignment="Center"/>
                <Slider x:Name="ZoomSlider" Minimum="120" Maximum="400" Value="200" Width="200"/>
                <!-- Classic {Binding}, not x:Bind: x:Bind + Converter fails to compile when the
                     code-behind root is a Window (not FrameworkElement) — WinUI-desktop limitation. -->
                <TextBlock Foreground="Red" VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <GridView
                x:Name="PagesGridView"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Pages}"
                CanReorderItems="True"
                AllowDrop="True"
                CanDragItems="True"
                SelectionMode="Extended"
                IsItemClickEnabled="False"
                KeyDown="PagesGridView_KeyDown">
                <GridView.Resources>
                    <!-- GridViewItem's default template paints PointerOver/Pressed/Selected chrome
                         above the item's own content, which was washing out the always-visible
                         corner buttons on hover — overriding individual brush resources didn't
                         fix it, so this replaces the container template entirely with a plain
                         ContentPresenter (no built-in hover/selection visuals at all). Selection is
                         drawn manually in the DataTemplate below via the Border bound to IsSelected. -->
                    <Style x:Key="TileContainerStyle" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Button's own default template has a PointerOver visual state that
                         overrides Background on hover — against the thumbnail underneath, that
                         read as the button "disappearing". This template is static: no hover,
                         pressed, or disabled visual changes at all. -->
                    <Style x:Key="IconButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="#AA000000"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <StaticResource ResourceKey="TileContainerStyle"/>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageItem">
                        <Grid
                            Tag="{x:Bind}"
                            Width="{Binding ElementName=ZoomSlider, Path=Value}"
                            Height="{Binding ElementName=ZoomSlider, Path=Value}"
                            Margin="4"
                            DoubleTapped="Tile_DoubleTapped">

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Image
                                        Source="{x:Bind ThumbnailSource, Mode=OneWay}"
                                        Stretch="Uniform"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="{x:Bind RotationDegrees, Mode=OneWay}"/>
                                        </Image.RenderTransform>
                                    </Image>

                                    <!-- Plain text, not ProgressRing: ProgressRing.IsActive crashed
                                         natively (Microsoft.UI.Xaml.dll, 0xc000027b) inside this
                                         virtualized GridView item template — confirmed via
                                         bisection, see project memory (winui-native-crash-notes). -->
                                    <TextBlock
                                        Text="Loading…"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <StackPanel
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <FontIcon Glyph="&#xE783;" FontSize="24" Foreground="Red"/>
                                        <TextBlock Text="Can't load" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Background="{ThemeResource SystemAccentColor}"
                                CornerRadius="10" Padding="8,2" Margin="6"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind PageNumber, Mode=OneWay}" Foreground="White" FontSize="12"/>
                            </Border>

                            <!-- Always visible, not hover-reveal: toggling Visibility off
                                 PointerEntered/Exited flickered when the pointer crossed onto the
                                 buttons themselves — a known WinUI nested-hit-test quirk. Simpler
                                 and more reliable to just keep these small and semi-transparent. -->
                            <StackPanel
                                Orientation="Horizontal" Spacing="4" Margin="6"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="PreviewButton_Click">
                                    <FontIcon Glyph="&#xE71E;" FontSize="14" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="RotateButton_Click">
                                    <FontIcon Glyph="&#xE7AD;" FontSize="14" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="RemoveButton_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White"/>
                                </Button>
                            </StackPanel>

                            <Border Background="#AA000000" VerticalAlignment="Bottom" Padding="6,2">
                                <TextBlock
                                    Text="{x:Bind FileName}" Foreground="White" FontSize="11"
                                    TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <Grid
            x:Name="PreviewOverlay"
            Background="#CC000000"
            Visibility="Collapsed"
            Tapped="PreviewOverlay_Tapped">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="40"/>
        </Grid>
    </Grid>
</Window>
